#!/bin/sh
# Фикстура cream 1.2 (build-token): хук install получил TOKEN — пишет его
# sha256 (не значение) и фазу в состояние.
set -eu
mkdir -p "$CREAM_STATE_DIR"
printf '%s' "${TOKEN:-}" | sha256sum | cut -d' ' -f1 >"$CREAM_STATE_DIR/token.sha256"
printf 'phase=%s level=%s\n' "${CREAM_PHASE:-}" "${LEVEL:-}" >>"$CREAM_STATE_DIR/install.log"
