# Машина «рабочий стол в облаке» для стадий configure cream 1.1.0 (§6.4): поверх
# образа cream-it (BASE_IMAGE, systemd как PID 1) — менеджер входа gdm3 и
# cloud-init. На ней проверяются стадии cloud-user (cloud-init.target, после
# cloud-final) и graphical (после display-manager) и отсутствие циклов порядка
# с ними. Сеанс в контейнере не поднимается (logind замаскирован) — проверяется
# порядок юнитов, а не графика.
ARG BASE_IMAGE=cream-it:ubuntu-24.04
FROM ${BASE_IMAGE}
RUN apt-get update \
	&& apt-get install -y --no-install-recommends gdm3 cloud-init \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*
