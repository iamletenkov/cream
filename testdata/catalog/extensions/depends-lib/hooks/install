#!/bin/sh
# Фикстура cream: хук install считает вызовы в $CREAM_STATE_DIR/install.count
# и дописывает окружение вызова в install.log.
set -eu
mkdir -p "$CREAM_STATE_DIR"
f="$CREAM_STATE_DIR/install.count"
n=0
if [ -f "$f" ]; then n=$(cat "$f"); fi
echo $((n + 1)) > "$f"
printf 'phase=%s reason=%s prev=%s changed=%s version=%s\n' \
    "${CREAM_PHASE:-}" "${CREAM_REASON:-}" "${CREAM_PREV_VERSION:-}" \
    "${CREAM_CHANGED_KEYS:-}" "${CREAM_EXT_VERSION:-}" >> "$CREAM_STATE_DIR/install.log"
root="${CREAM_ROOT%/}"
# shellcheck source=/dev/null
. "$root/opt/cream/ext/lib-fixture/files/lib.sh"
lib_fixture_greet depends-lib > "$CREAM_STATE_DIR/greeting"
