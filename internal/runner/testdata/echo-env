#!/bin/sh
# Печатает ровно то окружение, с которым процесс запущен (а не то, что добавил sh),
# рабочий каталог, stdin и содержимое fd 3, если он открыт.
tr '\0' '\n' < /proc/$$/environ | sed 's/^/env:/'
echo "cwd:$(pwd -P)"
echo "stdin:$(readlink /proc/$$/fd/0)"
if [ -e /proc/$$/fd/3 ]; then
	echo "fd3:$(cat <&3)"
fi
